{
  "name": "@pardovot/pixinsight-mcp",
  "version": "0.9.1",
  "description": "MCP server bridging AI assistants with PixInsight for astrophotography processing",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "pixinsight-mcp": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "author": "pardovot",
  "contributors": [
    "Alain Escaffre (originator of the project this one grew from)",
    "Andre Couto (V8 runtime port of the watcher)"
  ],
  "homepage": "https://github.com/pardovot/pixinsight-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pardovot/pixinsight-mcp.git"
  },
  "scripts": {
    "build": "tsc && node scripts/check-handler-drift.mjs",
    "test": "tsc && node --test && node scripts/check-handler-drift.mjs",
    "test:recipe": "node scripts/smoke-osc-rgb-linear.mjs",
    "library": "node scripts/add-library-entry.mjs",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "setup-bridge": "node -e \"const fs=require('fs'),os=require('os'),p=require('path'),b=p.join(os.homedir(),'.pixinsight-mcp');['bridge/commands','bridge/results','bridge/logs'].forEach(d=>fs.mkdirSync(p.join(b,d),{recursive:true}))\"",
    "module:config": "node module/config.mjs",
    "module:pcl": "node module/build-pcl.mjs",
    "module:build": "node module/build.mjs",
    "module:sign": "node module/sign.mjs",
    "module:verify": "node module/sign.mjs --verify",
    "module:install": "node module/install.mjs",
    "repo:build": "node scripts/build-pi-repo.mjs",
    "repo:sign": "node module/sign-xri.mjs pi-repo/updates.xri",
    "repo:verify": "node module/sign-xri.mjs --verify pi-repo/updates.xri",
    "test:flightcheck": "node node_modules/mcp-flightcheck/dist/cli.js node build/index.js",
    "test:security": "npm audit --audit-level=low"
  },
  "keywords": [
    "pixinsight",
    "mcp",
    "astrophotography",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "mcp-flightcheck": "0.1.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  }
}
